---
import { getCollection } from "astro:content"
import { sortBy, take, toLower } from "ramda";

import blog from "@/blog-utils.ts";
import { homepages } from "@/wiki-utils.ts";
import BlogEntry from "./BlogEntry.astro";

interface Props {
  expandBlogPosts: boolean;
}

const { expandBlogPosts = false } = Astro.props;

const sortByNameCaseInsensitive = sortBy((entry: any) => toLower(entry.data.name));

const games = sortByNameCaseInsensitive(await getCollection("games"));
---
<aside>
  <nav>
    <ul>
      <li><a href="/">Home</a></li>
      {games.map(game => 
        <li>
          <a href={`/games/${game.id}`}>
            {game.data.name}
          </a>
        </li>
      )}
      {blog.length > 0 &&
      <>
      <li><a href="/blog/1">Blog</a></li>
      {expandBlogPosts ?
        take(10, blog).map(
          post => <li><small><BlogEntry blog={post} /></small></li>
        )
      :
      <></>
      }
      </>
      }
      {homepages.map(entry => 
        <li>
          <a href={`/wiki/${entry.id}`}>{entry.data.name}</a>
        </li>
      )
      }
    </ul>
  </nav>
</aside>
<style lang="scss">
  aside {
    position: sticky;
    top: 0;
  }
</style>