---
import Top from "@/layouts/Top.astro"
import BlogList from "@/components/BlogList.astro";
import blog from "@/blog-utils.ts"

export async function getStaticPaths({paginate}: {paginate: any}) {
  const posts = blog.map(entry => ({id: entry.id}));
  return paginate(posts, { pageSize: 20});
}

const { page } = Astro.props;
const ids = page.data.map(entry => entry.id);
const posts = blog.filter(entry => ids.includes(entry.id));
---
<Top title=`Blog page ${page.currentPage}` expandBlogPosts={true}>
	<h1>Blog page {page.currentPage}</h1>
  <BlogList blogs={posts} />
</Top>
