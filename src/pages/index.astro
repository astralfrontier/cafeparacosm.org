---
import Top from "@/layouts/Top.astro"
import Game from "@/components/Game.astro"

import { getCollection } from "astro:content";

const games = (await getCollection("games")).sort(function (a, b) {
  if (a.id < b.id) {
    return -1;
  }
  if (a.id > b.id) {
    return 1;
  }
  return 0;
});
---
<Top title="Home">
	<h1>Cafe Paracosm</h1>
  {games.map(game => <Game id={game.id} />)}
</Top>
