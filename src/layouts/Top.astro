---
import SidebarLeft from "@/components/SidebarLeft.astro";
import "./Top.scss";
import styles from "./Top.module.scss";
import type { ACTION_ERROR_CODES, ACTION_QUERY_PARAMS } from "astro:actions";

interface Props {
  title: string;
  expandBlogPosts?: boolean;
  colorScheme?: 'dark' | 'light';
}

const { title, expandBlogPosts = true, colorScheme } = Astro.props;

const colorSchemeProps = colorScheme ? { "data-theme": colorScheme } : {};
---
<html lang="en" {...colorSchemeProps}>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link rel="icon" href="/favicon.ico" type="image/ico">
    <title>{title}</title>
  </head>
  <body>
    <main class={`container ${styles.main}`}>
      <div class={styles.sidebarleft}>
        <SidebarLeft expandBlogPosts={expandBlogPosts} />
      </div>
      <div class={styles.content}>
        <slot />
      </div>
    </main>
  </body>
</html>
